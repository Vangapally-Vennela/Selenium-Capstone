<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Selenium Capstone Suite">
    <!-- Listeners -->
    <listeners>
        <listener class-name="com.capstone.listeners.TestListener"/>
        <listener class-name="com.capstone.listeners.RetryListener"/>
    </listeners>
    <!-- Smoke Suite -->
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="Smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.capstone.tests.LoginTest"/>
            <class name="com.capstone.tests.ProductListingTest"/>
            <class name="com.capstone.tests.ProductDetailsTest"/>
            <class name="com.capstone.tests.ShoppingCartTest"/>
            <class name="com.capstone.tests.NavigationTest"/>
            <class name="com.capstone.tests.CheckoutTest"/>
            <class name="com.capstone.tests.EndToEndTest"/>
        </classes>
    </test>
    <!-- Regression Suite -->
    <test name="Regression Tests">
        <groups>
            <run>
                <include name="Regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.capstone.tests.LoginTest"/>
            <class name="com.capstone.tests.ProductListingTest"/>
            <class name="com.capstone.tests.ProductDetailsTest"/>
            <class name="com.capstone.tests.ShoppingCartTest"/>
            <class name="com.capstone.tests.NavigationTest"/>
            <class name="com.capstone.tests.CheckoutTest"/>
            <class name="com.capstone.tests.EndToEndTest"/>
        </classes>
    </test>
</suite>

